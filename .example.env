# Copy this file to a .env file in the tergite-autocalibration folder on the root level.
# The .env file is a simple list of keys and values. It is also known as the INI file on MS Windows.
# Fill in the necessary values. Note that all values in this template are example values.

# Logging settings
# Following the log levels of the built-in Python logging library
# The STDOUT_LOG_LEVEL is the logging level for the console prints
# Default is 25 to prevent very low level information from third-party libraries to be logged
STDOUT_LOG_LEVEL='25'
# The FILE_LOG_LEVEL is put on 10 to contain all debug information
FILE_LOG_LEVEL='10'

# Configuration variables
# CLUSTER_IP is the IP address of the instrument cluster to connect with
CLUSTER_IP='192.14.2.1'
# SPI_SERIAL_PORT is the port on which the spi rack is connected.
SPI_SERIAL_PORT='/dev/ttyACM0'

# REDIS_URL is the URL to the redis server that is to be used effectively
# as RAM for this calibration
# Default: 'redis://127.0.0.1:6379/0'
REDIS_URL='redis://127.0.0.1:6379/0'


# ----------------
# Optional section
# ----------------
# Variables in this section are reasonably detected automatically by default.
# Please only change them if you are running a very specific setup.

# TARGET_NODE: the calibration node on which to stop. The value is the
# lower-case name of one of the entries in `lib/nodes/__init__.py::NodeEnum`,
# e.g. 'resonator_spectroscopy' or 'qubit_01_spectroscopy'.
# Default: not set (must be provided by the caller)
# TARGET_NODE='qubit_01_spectroscopy'

# DATA_DIR: the folder where to put the calibration data output during calibration
# Default: 'out' in the working directory
DATA_DIR='out'

# CLUSTER_MODE: how to drive the cluster. Allowed values: 'real',
# 'dummy', 're_analyse'.
# Default: 'real'
CLUSTER_MODE='real'

# SPI_MODE: how to drive the SPI rack. Allowed values: 'real', 'dummy'.
# Default: 'dummy'
SPI_MODE='dummy'

# QUBITS: comma-separated list of qubits to calibrate.
# Default: not set
# QUBITS='q00,q01'

# COUPLERS: comma-separated list of couplers to calibrate.
# Default: not set
# COUPLERS='q00_q01'

# NAME: a human-readable name for the run. Defaults to TARGET_NODE.
# NAME='my-calibration-run'

# CLUSTER_TIMEOUT: seconds to wait when retrieving acquisitions from the
# cluster.
# Default: 222
                                                                        CLUSTER_TIMEOUT=222

# Name of the file that has the list of other config files
# Default:  "configuration.meta.toml"
CONFIG_META_FILENAME='configuration.meta.toml'

# IS_RECALIBRATION: whether the current session is to recalibrate
# Default: True
IS_RECALIBRATION=True

# IGNORE_SPEC: whether to recalibrate the nodes by ignoring the
# previous calibration status
# Default: True
IGNORE_SPEC=True

# SAVE_PLOT is a boolean to indicate whether plots should be saved.
# Default: False
SAVE_PLOT=False

# FIXED_DURATION_COUPLERS: a comma-separated list of couplers with fixed
# duration working points for cz calibration
# DEFAULT=""
FIXED_DURATION_COUPLERS="q11_q12,q14_q15"
